# Copia este archivo a .env.local. Nunca publiques las claves reales en Git.
# URL canónica para Auth.js (producción); usa http://localhost:3000 en desarrollo.
AUTH_URL=https://alojamientospiffre.cl
# Genera un secreto aleatorio de al menos 32 bytes.
AUTH_SECRET=
# Sign in with Vercel App, scopes openid email profile.
# Callback producción: https://alojamientospiffre.cl/api/auth/callback/vercel
# Callback local: http://localhost:3000/api/auth/callback/vercel
AUTH_VERCEL_ID=
AUTH_VERCEL_SECRET=
ADMIN_EMAILS=alojamientospiffre@gmail.com

# Variables exclusivamente de servidor; ninguna lleva NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
